{
  "name": "skillproof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["server", "client"],
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:start": "npm run db:start -w server",
    "migrate": "npm run migrate -w server",
