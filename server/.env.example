# Copy to server/.env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local: matches `npm run db:start` (embedded PostgreSQL on port 5433).
# Production: your Neon connection string, e.g. postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://skillproof:skillproof@localhost:5433/skillproof

# Browser origin(s) allowed to call the API, comma-separated. The first one is used in email links.
APP_ORIGIN=http://localhost:5173

# Number of proxies in front of the API (Render + Vercel rewrite = 2). Use "loopback" locally.
TRUST_PROXY=loopback

# Required. https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Daily AI allowance per student
AI_DAILY_ASSESSMENTS=5
AI_DAILY_FEEDBACK=20

# Optional: Brevo transactional email (https://app.brevo.com/settings/keys/api).
# Without it, verification/reset emails are printed to the server log.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SkillProof

# Optional: Cloudinary for avatars and certificates (https://console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: raises GitHub API limit from 60 to 5000 requests/hour (token with no scopes)
GITHUB_TOKEN=

LOG_LEVEL=info
